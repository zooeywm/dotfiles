[Unit]
Description=NapCat QQ 协议端（无头 NTQQ，Xvfb 运行，OneBot v11 HTTP）
Documentation=https://napneko.github.io/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# napcat-qq 内部用 xvfb-run 启动注入过 launcher 的 QQ
ExecStart=/usr/bin/napcat-qq -q 2700226069
WorkingDirectory=%h/.config/napcat-qq-plugin
Environment=HOME=%h
Restart=on-failure
RestartSec=10
# QQ 是 Electron 多进程，整组结束
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
