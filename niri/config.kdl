// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
//
// Using https://danklinux.com/docs/getting-started

include "dms/colors.kdl"

workspace "main" {
    open-on-output "eDP-1"
}
workspace "browser" {
    open-on-output "HDMI-A-1"
}
workspace "misc" {
    open-on-output "eDP-1"
}
workspace "chat" {
    open-on-output "eDP-1"
}

layout {
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
    tab-indicator {
        // hide-when-single-tab
        width 10
        gap 4
        length total-proportion=0.8
        position "left"
        gaps-between-tabs 2
        corner-radius 4
        // position "top"
        place-within-column

        active-color "#8bd2ff"
        inactive-color "#5d6077"
        urgent-color "#f38ba8"
    }
    shadow {
        off
    }
}

environment {
    LC_MESSAGES "en_US.UTF-8"
    // NOTE: https://fcitx-im.org/wiki/Using_Fcitx_5_on_Wayland#KDE_Plasma
    XMODIFIERS "@im=fcitx"
    JAVA_TOOL_OPTIONS "-Dsun.java2d.uiScale=2" // 高分屏用
    QT_AUTO_SCREEN_SCALE_FACTOR "0"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_ENABLE_HIGHDPI_SCALING "1"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    MOZ_ENABLE_WAYLAND "1"
}

input {
    keyboard {
        numlock
        repeat-delay 150
        repeat-rate 200
    }
    touchpad {
        tap
        dwt
    }
    mouse {
        // off
        // natural-scroll
        // accel-speed 1
        // accel-profile "adaptive"
    }
    mod-key "Super"
    // focus-follows-mouse
}

config-notification {
    disable-failed
}


gestures {
    hot-corners {
        off
    }
}

xwayland-satellite {
    path "/usr/bin/xwayland-satellite"
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}
overview {
    workspace-shadow {
        off
    }
}

switch-events {
    lid-close { spawn "notify-send" "The laptop lid is closed!"; }
    lid-open { spawn "notify-send" "The laptop lid is open!"; }
    tablet-mode-on { spawn "bash" "-c" "gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true"; }
    tablet-mode-off { spawn "bash" "-c" "gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled false"; }
}

spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri & /usr/lib/xdg-desktop-portal-hyprland"
spawn-sh-at-startup "udiskie --tray"
spawn-sh-at-startup "xrdb -merge ~/.Xresources"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d_%H_%M_%S.png"

cursor {
    xcursor-theme "Breeze_Light"
    xcursor-size 48
}

animations {
    workspace-switch {
        spring damping-ratio=0.78 stiffness=520 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }
    window-close {
        duration-ms 140
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }
    horizontal-view-movement {
        spring damping-ratio=0.80 stiffness=470 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.76 stiffness=390 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.80 stiffness=470 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.74 stiffness=760 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 170
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }
    overview-open-close {
        spring damping-ratio=0.78 stiffness=760 epsilon=0.0001
    }
}

debug {
    honor-xdg-activation-with-invalid-serial
    enable-overlay-planes
}

// window-rule {
//     background-effect {
//         blur true
//         xray false
//         noise 0.05
//         saturation 3
//     }
// }

// Include dms files
include "dms/layout.kdl"
include "dms/alttab.kdl"
include "dms/binds.kdl"
include "dms/outputs.kdl"

include "dms/cursor.kdl"
include "dms/input.kdl"

// Open windows as floating by default.
window-rule {
    open-floating true
}

// Keep browsers and terminals in the tiling layout.
window-rule {
    match app-id=r#"^(chromium|google-chrome|google-chrome-stable)$"#
    open-floating false
}

window-rule {
    match app-id=r#"^(kitty|Alacritty)$"#
    open-floating false
}

// Load DMS rules after the global defaults so specific DMS rules win.
include "dms/windowrules.kdl"

// 自定义快捷键：放在 dms/*.kdl include 之后，覆盖 DMS 生成的同名绑定。
// app-toggle：按一下打开窗口，再按一下关闭（有托盘的 app 关闭时收进托盘，不退出、不开新实例）。
binds {
    // Mod+A：QQ
    Mod+A repeat=false hotkey-overlay-title="QQ" { spawn-sh "$HOME/.local/bin/app-toggle '^(qq|linuxqq)' /opt/QQ qq"; }
    // Mod+C：飞书（DMS 生成文件里 Mod+A 原本是飞书，被上面覆盖了；Mod+C 原本是 center-column，也被这条覆盖）
    Mod+C repeat=false hotkey-overlay-title="飞书" { spawn-sh "$HOME/.local/bin/app-toggle '^feishu$' bytedance-feishu-stable feishu"; }
    // Mod+E：微信（DMS 生成的 Mod+E 是直接启动微信，这里改成开关）
    Mod+E repeat=false hotkey-overlay-title="微信" { spawn-sh "$HOME/.local/bin/app-toggle '^wechat$' /opt/wechat-universal wechat-universal"; }
}

