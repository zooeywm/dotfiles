#!/usr/bin/env python3
"""Telegram ↔ DSH 桥。

把你发给 bot 的文字交给 `dsh --profile headless` 的一个持久会话，再把回答发回去。
- 凭据/目标：~/.config/dsh/telegram.json（token、chat_id、可选 cwd）
- 会话与 offset：~/.config/dsh/tg-bot-state.json
- TINGYU_API_KEY 从 ~/.dsh/.credentials.yaml 读取后传给子进程

运行中的思考/工具调用会**追加到同一条进度消息**里（editMessageText 原地刷新），
不再刷屏；回答单独发。超过 5 秒没动静会先发进度消息回执。

用法（systemd 用户服务 dsh-tg-bot.service 常驻）：
    dsh-tg-bot
"""

import json
import os
import queue
import re
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/home/zooeywm"))
CFG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "dsh/telegram.json"
STATE = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "dsh/tg-bot-state.json"
CREDS = HOME / ".dsh/.credentials.yaml"
DSH = HOME / ".cache/.bun/bin/dsh"
PROFILE = "headless"
AGENT_TIMEOUT = int(os.environ.get("DSH_TG_TIMEOUT", "900"))
ACK_AFTER = 5           # 秒：没动静先发进度消息
FLUSH_EVERY = 2.5       # 秒：进度消息刷新节流
HEARTBEAT = 120         # 秒：长任务心跳
MAX_PROGRESS_CHARS = 3800
MAX_CHUNK = 3500

HELP = """我是跑在你 Arch 机器上的 DSH，可以直接让我干活：

/new    开新会话（清空上下文）
/status 查看当前会话信息
/id     显示你的 chat id
/help   这条帮助

直接发文字就行，我会在固定会话里接着聊；
运行中的思考和工具调用会实时更新在同一条进度消息里。"""


def log(*args):
    print(time.strftime("%H:%M:%S"), *args, file=sys.stderr, flush=True)


def read_api_key():
    """从 dsh 凭据文件里取 TINGYU_API_KEY。"""
    try:
        text = CREDS.read_text()
    except OSError:
        return None
    m = re.search(r"^\s*TINGYU_API_KEY:\s*(\S+)\s*$", text, re.M)
    return m.group(1) if m else None


def clip(text, limit=160):
    text = re.sub(r"\s+", " ", str(text)).strip()
    return text if len(text) <= limit else text[: limit - 1] + "…"


class Progress:
    """一条会被原地编辑的进度消息：思考/工具调用不断追加，不刷屏。"""

    def __init__(self, bot):
        self.bot = bot
        self.message_id = None
        self.lines = []
        self.dirty = False
        self.last_flush = 0.0
        self.done = False

    def add(self, line):
        if not line:
            return
        self.lines.append(line)
        self.dirty = True

    def body(self, header):
        shown, total = [], 0
        for line in reversed(self.lines):
            total += len(line) + 1
            if total > MAX_PROGRESS_CHARS:
                shown.append("…（前面省略）")
                break
            shown.append(line)
        shown.reverse()
        return "\n".join([header, *shown]) if shown else header

    def flush(self, header, force=False):
        if self.done:
            return
        now = time.monotonic()
        if not force and (not self.dirty or now - self.last_flush < FLUSH_EVERY):
            return
        text = self.body(header)
        try:
            if self.message_id is None:
                resp = self.bot.call("sendMessage", {"chat_id": self.bot.chat_id, "text": text})
                self.message_id = ((resp.get("result") or {}).get("message_id"))
            else:
                try:
                    self.bot.call(
                        "editMessageText",
                        {"chat_id": self.bot.chat_id, "message_id": self.message_id, "text": text},
                    )
                except urllib.error.HTTPError as exc:
                    detail = exc.read().decode(errors="replace")
                    if "message is not modified" not in detail:
                        log("editMessageText failed:", detail[:200])
        except (urllib.error.URLError, OSError) as exc:
            log("progress flush failed:", exc)
        self.dirty = False
        self.last_flush = now

    def finish(self, header):
        self.done = True
        if self.message_id is None:
            if self.lines:
                self.bot.send(self.body(header))
            return
        text = self.body(header)
        try:
            self.bot.call(
                "editMessageText",
                {"chat_id": self.bot.chat_id, "message_id": self.message_id, "text": text},
            )
        except (urllib.error.URLError, urllib.error.HTTPError, OSError) as exc:
            log("progress finish failed:", exc)


class Bot:
    def __init__(self):
        cfg = json.loads(CFG.read_text())
        self.token = cfg["token"]
        self.chat_id = int(cfg["chat_id"])
        self.cwd = cfg.get("cwd") or str(HOME)
        self.api_key = read_api_key()
        try:
            self.state = json.loads(STATE.read_text())
        except (OSError, json.JSONDecodeError):
            self.state = {"offset": 0, "session_id": None}
        self.base = f"https://api.telegram.org/bot{self.token}"

    # ---------- telegram ----------
    def call(self, method, params=None, timeout=60):
        data = None
        url = f"{self.base}/{method}"
        if params is not None:
            data = urllib.parse.urlencode(params).encode()
        req = urllib.request.Request(url, data=data)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode())

    def send(self, text):
        for i in range(0, len(text), MAX_CHUNK):
            chunk = text[i : i + MAX_CHUNK]
            try:
                self.call(
                    "sendMessage",
                    {"chat_id": self.chat_id, "text": chunk, "disable_web_page_preview": "true"},
                )
            except (urllib.error.URLError, OSError) as exc:
                log("sendMessage failed:", exc)
                return

    def typing(self):
        try:
            self.call("sendChatAction", {"chat_id": self.chat_id, "action": "typing"})
        except (urllib.error.URLError, OSError):
            pass

    # ---------- dsh ----------
    def env(self):
        env = dict(os.environ)
        if self.api_key:
            env.setdefault("TINGYU_API_KEY", self.api_key)
        env["DSH_HOME"] = str(HOME / ".dsh")
        return env

    def run_agent(self, text):
        """跑一次会话，返回 (session_id, 最终文本)。思考/工具调用写进同一条进度消息。"""
        cmd = [str(DSH), "--profile", PROFILE]
        sid = self.state.get("session_id")
        if sid:
            cmd += ["--session-id", sid]
        cmd += ["--json", text]
        log("run:", " ".join(cmd), f"({len(text)} chars)")

        proc = subprocess.Popen(
            cmd,
            cwd=self.cwd,
            env=self.env(),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
        out_q: queue.Queue = queue.Queue()
        err_lines: list[str] = []

        def reader():
            assert proc.stdout is not None
            for line in proc.stdout:
                out_q.put(line)
            out_q.put(None)

        def err_reader():
            assert proc.stderr is not None
            for line in proc.stderr:
                err_lines.append(line.rstrip())
                del err_lines[:-20]

        threading.Thread(target=reader, daemon=True).start()
        threading.Thread(target=err_reader, daemon=True).start()

        started = time.monotonic()
        session_id = sid
        final_text = ""
        text_parts: list[str] = []
        progress = Progress(self)
        last_heartbeat = started
        deadline = started + AGENT_TIMEOUT
        header = "⏳ 正在处理…"

        while True:
            try:
                line = out_q.get(timeout=1.0)
            except queue.Empty:
                now = time.monotonic()
                if now > deadline:
                    progress.finish("⏱ 超时中断")
                    proc.kill()
                    raise subprocess.TimeoutExpired(cmd, AGENT_TIMEOUT)
                if not progress.lines and now - started >= ACK_AFTER:
                    progress.flush(header, force=True)
                elif now - last_heartbeat >= HEARTBEAT:
                    progress.add(f"⏱ 已经跑了 {int(now - started)} 秒…")
                    progress.flush(header, force=True)
                    last_heartbeat = now
                progress.flush(header)
                continue
            if line is None:
                break
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            kind = event.get("type")
            if kind == "session" and event.get("sessionId"):
                session_id = event["sessionId"]
            elif kind == "thinking":
                thought = clip(event.get("text") or "", 300)
                if thought:
                    progress.add(f"🧠 {thought}")
            elif kind == "tool_call":
                tool = event.get("tool") or "?"
                data = event.get("input") or {}
                detail = ""
                if isinstance(data, dict):
                    for key in ("command", "path", "file_path", "pattern", "prompt", "description"):
                        if data.get(key):
                            detail = clip(data[key], 160)
                            break
                    if not detail:
                        detail = clip(json.dumps(data, ensure_ascii=False), 120)
                progress.add(f"🔧 {tool}: {detail}")
            elif kind == "tool_result":
                status = event.get("status")
                if status not in (None, "completed"):
                    progress.add(f"⚠️ 工具失败: {clip(event.get('result') or '', 200)}")
            elif kind == "text":
                chunk = event.get("text") or ""
                if chunk:
                    text_parts.append(chunk)
            elif kind == "final":
                final_text = event.get("text") or ""
            progress.flush(header)

        proc.wait(timeout=30)
        elapsed = int(time.monotonic() - started)
        if proc.returncode not in (0, None):
            err = err_lines[-1] if err_lines else f"exit {proc.returncode}"
            progress.finish("❌ 出错了")
            raise RuntimeError(err)
        if not session_id:
            progress.finish("❌ 出错了")
            raise RuntimeError("没拿到会话 id")
        progress.finish(f"✅ 完成（{elapsed}s）")
        answer = final_text.strip() or "".join(text_parts).strip() or "(空回答)"
        return session_id, answer

    def ask(self, text):
        session_id, answer = self.run_agent(text)
        if session_id != self.state.get("session_id"):
            self.state["session_id"] = session_id
            self.save()
        return answer

    def save(self):
        STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state, ensure_ascii=False, indent=1))
        tmp.chmod(0o600)
        tmp.replace(STATE)

    # ---------- main loop ----------
    def handle(self, update):
        msg = update.get("message") or update.get("edited_message") or {}
        chat = msg.get("chat") or {}
        if chat.get("id") != self.chat_id:
            return
        text = msg.get("text") or msg.get("caption") or ""
        if not text.strip():
            self.send("目前只支持文字消息。")
            return
        text = text.strip()
        if text in ("/start", "/help"):
            self.send(HELP)
            return
        if text == "/id":
            self.send(f"chat_id: {chat.get('id')}")
            return
        if text == "/new":
            self.state["session_id"] = None
            self.save()
            self.send("已开新会话。")
            return
        if text == "/status":
            self.send(
                f"会话: {self.state.get('session_id') or '(下条消息新建)'}\n"
                f"工作目录: {self.cwd}\n模型 profile: {PROFILE}"
            )
            return
        self.typing()
        started = time.monotonic()
        try:
            answer = self.ask(text)
        except subprocess.TimeoutExpired:
            self.send(f"超时（{AGENT_TIMEOUT}s），任务可能还在后台跑，稍后再问我状态。")
            return
        except Exception as exc:  # noqa: BLE001
            self.send(f"出错了：{exc}")
            return
        elapsed = int(time.monotonic() - started)
        self.send(answer)
        if elapsed >= 20:
            self.send(f"（耗时 {elapsed}s）")

    def loop(self):
        log("bot started, chat_id =", self.chat_id)
        while True:
            try:
                resp = self.call(
                    "getUpdates",
                    {"offset": self.state["offset"], "timeout": 50, "allowed_updates": '["message","edited_message"]'},
                    timeout=70,
                )
            except (urllib.error.URLError, OSError, TimeoutError) as exc:
                log("getUpdates failed:", exc)
                time.sleep(5)
                continue
            for update in resp.get("result", []):
                self.state["offset"] = update["update_id"] + 1
                try:
                    self.handle(update)
                except Exception as exc:  # noqa: BLE001
                    log("handle failed:", exc)
                self.save()


def main():
    try:
        Bot().loop()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
