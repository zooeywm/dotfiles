// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1771915632334912837 @name=org.fcitx.fcitx5-config-qt
window-rule {
    match app-id="^org.fcitx.fcitx5-config-qt$"
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
}

// @id=wr_1771915753957743379 @name=org.fcitx.fcitx5-qt6-gui-wrapper
window-rule {
    match app-id="^org.fcitx.fcitx5-qt6-gui-wrapper$"
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
}

// @id=wr_1774840848141857901 @name=alacritty
window-rule {
    match app-id="^Alacritty$"
    opacity 0.85
}

// @id=dms_rule_42 @name=
window-rule {
    match app-id="^kitty$"
    opacity 0.85
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=wr_1788749799444864040 @name=codex-desktop
window-rule {
    match app-id="^codex-desktop$"
    open-floating false
}
