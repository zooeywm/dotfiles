[Unit]
Description=生成 AI/科技新闻简报并通过 QQ 发送
After=network-online.target
Wants=network-online.target
# NapCat 没起来时也尝试跑（脚本自身会报错退出），但不因它失败而拖住
After=napcat.service

[Service]
Type=oneshot
Environment=PATH=/home/zooeywm/.local/share/mise/installs/node/24/bin:/home/zooeywm/.cache/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/qq-news-report
TimeoutStartSec=600
Nice=10
