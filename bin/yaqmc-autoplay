#!/bin/sh
# 启动 YAQMC，并在恢复播放队列后自动继续播放。
# YAQMC 自身的设计是“恢复的曲目保持暂停”，所以这里用它的本地 HTTP API 补一步 play。
set -u
APP=/opt/yaqmc/yaqmc
PORT="${YAQMC_API_PORT:-19532}"
TOKEN="${YAQMC_API_TOKEN:-$(secret-tool lookup service org.yaqmc.desktop username local-api-bearer-token 2>/dev/null || true)}"

"$APP" "$@" &
APP_PID=$!

if [ -n "$TOKEN" ]; then
    AUTH="Authorization: Bearer $TOKEN"
else
    AUTH="X-No-Auth: 1"
fi

api() { curl -s -m 3 -H "$AUTH" "http://127.0.0.1:$PORT$1" 2>/dev/null; }

# 等本地 API 就绪（最多 30 秒）
i=0
while [ "$i" -lt 60 ]; do
    code=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$PORT/health" 2>/dev/null || echo 000)
    [ "$code" = "200" ] && break
    i=$((i + 1))
    sleep 0.5
done

# 等恢复的队列出现当前曲目（最多 20 秒）
idx=""
playing="false"
i=0
while [ "$i" -lt 40 ]; do
    snapshot=$(api /v1/player)
    idx=$(printf '%s' "$snapshot" | jq -r '.currentIndex // empty' 2>/dev/null)
    playing=$(printf '%s' "$snapshot" | jq -r '.isPlaying // false' 2>/dev/null)
    [ -n "$idx" ] && break
    i=$((i + 1))
    sleep 0.5
done

# 有当前曲目且未在播放时，继续播放
if [ -n "$idx" ] && [ "$playing" != "true" ]; then
    curl -s -o /dev/null -m 5 -X POST -H "$AUTH" "http://127.0.0.1:$PORT/v1/player/play" 2>/dev/null
fi

wait "$APP_PID"
